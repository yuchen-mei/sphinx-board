(text "J602: 1 = Zed Pmod3.3V; 2 = Zed GPIO LOW/Z (NOT GND).\nLOW asserts reset; Z/unplugged leaves local control unchanged.\nNo conductive connection from either input pin to board power/GND." (at 170 258 0) (effects (font (size 0.9 0.9)) (justify left top) ) (uuid "fff25c39-f4f5-57fe-bab5-365537bbdfc6"))
(text "GP15: OPEN-DRAIN shutdown; LOW clears RUN_LATCH. Never drive HW_FAULT_N push-pull HIGH." (at 15 276 0) (effects (font (size 1.0 1.0)) (justify left top) ) (uuid "04a038d2-0a0b-53d8-90bb-53929b0dfa9b"))(sheet_instances (path "/f39c8d6a-e478-5a84-9c95-766dfa82ae02/75c9142f-37c4-500b-ad86-039aa4577f35" (page "5"))) (embedded_fonts no)
